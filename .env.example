# Google Gemini API (FREE - Get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key-here

# OpenRouter (FREE tier available - Get key at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Freebuff (Optional - requires Freebuff2API proxy)
FREEBUFF_API_KEY=your-freebuff-token
FREEBUFF_BASE_URL=http://localhost:8080

# Custom OpenAI-compatible API (Optional)
CUSTOM_AI_API_KEY=your-key
CUSTOM_AI_BASE_URL=https://your-api.com/v1

# Server Configuration
PORT=3001
WORKSPACE=/path/to/your/workspace
